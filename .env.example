# Copy to .env for local shell usage. Do not commit real secrets.

# Spring profile and server port
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
PORT=8080

# Public URL used when building short links
APP_BASE_URL=http://localhost:8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urlshortener
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/urlshortener

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT
# Use a strong random value with at least 32 characters outside local dev.
JWT_SECRET=replace-this-with-a-strong-32-character-minimum-secret
JWT_EXPIRATION=1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Async analytics
ANALYTICS_BATCH_SIZE=500
ANALYTICS_INTERVAL_MS=1000
ANALYTICS_QUEUE_CAPACITY=10000
ANALYTICS_SLOW_QUERY_THRESHOLD_MS=500
